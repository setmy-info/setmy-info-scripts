#!/bin/sh

# Copyright (C) 2026 Imre Tabur <imre.tabur@mail.ee>

set -eu

. $(smi-include ai-agents.sh)

AGENT=claude
PROMPT_FILE=TASKLIST.sexp
MODEL=""
REASONING=""

while [ $# -gt 0 ]; do
    case "${1}" in
        --agent)
            AGENT=${2:?--agent needs a value}
            shift 2
            ;;
        --prompt-file)
            PROMPT_FILE=${2:?--prompt-file needs a value}
            shift 2
            ;;
        --model)
            MODEL=${2:?--model needs a value}
            shift 2
            ;;
        --reasoning)
            REASONING=${2:?--reasoning needs a value}
            shift 2
            ;;
        *)
            break
            ;;
    esac
done

requireAgent "${AGENT}"
requirePromptFile "${PROMPT_FILE}"

AGENT_CLI_OPTIONS=$(agentCliOptions "${AGENT}" ${MODEL:+--model ${MODEL}} ${REASONING:+--reasoning ${REASONING}})

"${AGENT}CLI" "${PROMPT_FILE}" ${AGENT_CLI_OPTIONS} "$@"

exit ${?}
