#!/bin/sh

# Copyright (C) 2026 Imre Tabur <imre.tabur@mail.ee>

set -eu

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    echo "Usage: $0 <client_name> [aws_region]" >&2
    exit 1
fi

CLIENT_NAME=$1
AWS_REGION=${2:-eu-central-1}

case "$CLIENT_NAME" in
    ''|[!a-z]*|*[!a-z0-9-]*|*-)
        echo "ERROR: Invalid client name: $CLIENT_NAME" >&2
        exit 1
        ;;
esac

if [ "${#CLIENT_NAME}" -gt 32 ]; then
    echo "ERROR: Client name longer than 32 characters: $CLIENT_NAME" >&2
    exit 1
fi

case "$AWS_REGION" in
    [a-z][a-z]-*-[0-9]|[a-z][a-z]-*-*-[0-9])
        ;;
    *)
        echo "ERROR: Invalid AWS region: $AWS_REGION" >&2
        exit 1
        ;;
esac

sed -e "s/@CLIENT_NAME@/${CLIENT_NAME}/g" -e "s/@AWS_REGION@/${AWS_REGION}/g" <<'EOF'
# Generated by smi-aws-eks-create-tf. Works with OpenTofu and Terraform:
#   tofu init && tofu apply          or          terraform init && terraform apply
# Then: aws eks update-kubeconfig --region <region> --name <client_name> && kubectl get nodes

# 1. Tool and provider versions
terraform {
  required_version = ">= 1.6"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = ">= 5.40, < 7.0"
    }
  }
}

# 2. AWS cloud provider and region; every resource gets the default tags
provider "aws" {
  region = var.aws_region

  default_tags {
    tags = {
      Client    = var.client_name
      ManagedBy = "opentofu-terraform"
    }
  }
}

# 3. Input variables for per client automation
variable "aws_region" {
  type        = string
  description = "AWS region where everything is created"
  default     = "@AWS_REGION@"
}

variable "client_name" {
  type        = string
  description = "Unique client name or ID, also the name of the Kubernetes cluster"
  default     = "@CLIENT_NAME@"
}

variable "vpc_cidr" {
  type        = string
  description = "Address range of the client VPC"
  default     = "10.0.0.0/16"
}

variable "availability_zone_count" {
  type        = number
  description = "Number of availability zones used, EKS needs at least 2"
  default     = 2

  validation {
    condition     = var.availability_zone_count >= 2
    error_message = "EKS needs subnets in at least 2 availability zones."
  }
}

variable "kubernetes_version" {
  type        = string
  description = "Kubernetes version of the cluster, null for the current EKS default"
  default     = null
}

variable "cluster_endpoint_public_access_cidrs" {
  type        = list(string)
  description = "Addresses allowed to reach the Kubernetes API from the internet, restrict to the office or VPN addresses"
  default     = ["0.0.0.0/0"]
}

variable "cluster_log_types" {
  type        = list(string)
  description = "Control plane logs sent to CloudWatch Logs, empty list for none"
  default     = ["audit", "authenticator"]
}

variable "node_instance_types" {
  type        = list(string)
  description = "EC2 instance types of the worker nodes"
  default     = ["t3.medium"]
}

variable "node_capacity_type" {
  type        = string
  description = "ON_DEMAND, or SPOT for cheaper nodes that AWS may take back"
  default     = "ON_DEMAND"
}

variable "node_ami_type" {
  type        = string
  description = "Operating system image of the worker nodes, AL2023_ARM_64_STANDARD for Graviton instance types"
  default     = "AL2023_x86_64_STANDARD"
}

variable "node_disk_size" {
  type        = number
  description = "Disk size of a worker node in GiB"
  default     = 20
}

variable "node_desired_size" {
  type    = number
  default = 2
}

variable "node_min_size" {
  type    = number
  default = 1
}

variable "node_max_size" {
  type    = number
  default = 3
}

data "aws_availability_zones" "available" {
  state = "available"
}

locals {
  azs = slice(data.aws_availability_zones.available.names, 0, var.availability_zone_count)
}

# 4. Separate virtual network (VPC) of the client
resource "aws_vpc" "client_vpc" {
  cidr_block           = var.vpc_cidr
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name = "${var.client_name}-vpc"
  }
}

resource "aws_internet_gateway" "igw" {
  vpc_id = aws_vpc.client_vpc.id

  tags = {
    Name = "${var.client_name}-igw"
  }
}

# 5. Public subnets, one per availability zone, for internet facing load balancers and the NAT gateway
resource "aws_subnet" "public_subnet" {
  count                   = length(local.azs)
  vpc_id                  = aws_vpc.client_vpc.id
  availability_zone       = local.azs[count.index]
  cidr_block              = cidrsubnet(var.vpc_cidr, 8, count.index + 1)
  map_public_ip_on_launch = true

  tags = {
    Name                     = "${var.client_name}-public-subnet-${local.azs[count.index]}"
    "kubernetes.io/role/elb" = "1"
  }
}

# 6. Private subnets, one per availability zone, for the worker nodes and internal load balancers
resource "aws_subnet" "private_subnet" {
  count             = length(local.azs)
  vpc_id            = aws_vpc.client_vpc.id
  availability_zone = local.azs[count.index]
  cidr_block        = cidrsubnet(var.vpc_cidr, 4, count.index + 1)

  tags = {
    Name                              = "${var.client_name}-private-subnet-${local.azs[count.index]}"
    "kubernetes.io/role/internal-elb" = "1"
  }
}

# 7. One NAT gateway, so the private nodes reach the internet for images and updates without being reachable from it
resource "aws_eip" "nat" {
  domain = "vpc"

  tags = {
    Name = "${var.client_name}-nat-eip"
  }
}

resource "aws_nat_gateway" "nat" {
  allocation_id = aws_eip.nat.id
  subnet_id     = aws_subnet.public_subnet[0].id

  tags = {
    Name = "${var.client_name}-nat"
  }

  depends_on = [aws_internet_gateway.igw]
}

# 8. Routing: public subnets through the internet gateway, private subnets through the NAT gateway
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.client_vpc.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.igw.id
  }

  tags = {
    Name = "${var.client_name}-public-rt"
  }
}

resource "aws_route_table_association" "public" {
  count          = length(local.azs)
  subnet_id      = aws_subnet.public_subnet[count.index].id
  route_table_id = aws_route_table.public.id
}

resource "aws_route_table" "private" {
  vpc_id = aws_vpc.client_vpc.id

  route {
    cidr_block     = "0.0.0.0/0"
    nat_gateway_id = aws_nat_gateway.nat.id
  }

  tags = {
    Name = "${var.client_name}-private-rt"
  }
}

resource "aws_route_table_association" "private" {
  count          = length(local.azs)
  subnet_id      = aws_subnet.private_subnet[count.index].id
  route_table_id = aws_route_table.private.id
}

# 9. Firewall (security group) for web load balancers, opens ports 80 (HTTP) and 443 (HTTPS)
resource "aws_security_group" "web_sg" {
  name        = "${var.client_name}-web-sg"
  description = "Allow incoming web traffic to the cluster load balancers"
  vpc_id      = aws_vpc.client_vpc.id

  # Incoming HTTP traffic from all addresses
  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # Incoming HTTPS traffic from all addresses
  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  # Outgoing traffic, to the nodes behind the load balancer
  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "${var.client_name}-web-sg"
  }
}

# 10. IAM role of the EKS control plane
resource "aws_iam_role" "cluster" {
  name = "${var.client_name}-eks-cluster-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "eks.amazonaws.com" }
      Action    = ["sts:AssumeRole", "sts:TagSession"]
    }]
  })
}

resource "aws_iam_role_policy_attachment" "cluster_policy" {
  role       = aws_iam_role.cluster.name
  policy_arn = "arn:aws:iam::aws:policy/AmazonEKSClusterPolicy"
}

# 11. The Kubernetes cluster (EKS); whoever runs apply becomes its administrator
resource "aws_eks_cluster" "cluster" {
  name     = var.client_name
  version  = var.kubernetes_version
  role_arn = aws_iam_role.cluster.arn

  enabled_cluster_log_types = var.cluster_log_types

  access_config {
    authentication_mode                         = "API"
    bootstrap_cluster_creator_admin_permissions = true
  }

  vpc_config {
    subnet_ids              = concat(aws_subnet.private_subnet[*].id, aws_subnet.public_subnet[*].id)
    endpoint_private_access = true
    endpoint_public_access  = true
    public_access_cidrs     = var.cluster_endpoint_public_access_cidrs
  }

  depends_on = [aws_iam_role_policy_attachment.cluster_policy]
}

# 12. IAM role of the worker nodes
resource "aws_iam_role" "node" {
  name = "${var.client_name}-eks-node-role"

  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Principal = { Service = "ec2.amazonaws.com" }
      Action    = "sts:AssumeRole"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "node_policy" {
  for_each = toset([
    "arn:aws:iam::aws:policy/AmazonEKSWorkerNodePolicy",
    "arn:aws:iam::aws:policy/AmazonEKS_CNI_Policy",
    "arn:aws:iam::aws:policy/AmazonEC2ContainerRegistryReadOnly",
  ])

  role       = aws_iam_role.node.name
  policy_arn = each.value
}

# 13. Managed worker nodes in the private subnets
resource "aws_eks_node_group" "default" {
  cluster_name    = aws_eks_cluster.cluster.name
  node_group_name = "${var.client_name}-default"
  node_role_arn   = aws_iam_role.node.arn
  subnet_ids      = aws_subnet.private_subnet[*].id
  instance_types  = var.node_instance_types
  capacity_type   = var.node_capacity_type
  ami_type        = var.node_ami_type
  disk_size       = var.node_disk_size

  scaling_config {
    desired_size = var.node_desired_size
    min_size     = var.node_min_size
    max_size     = var.node_max_size
  }

  update_config {
    max_unavailable = 1
  }

  lifecycle {
    ignore_changes = [scaling_config[0].desired_size]
  }

  depends_on = [aws_iam_role_policy_attachment.node_policy]
}

# 14. Core cluster add-ons, managed and updated by EKS
resource "aws_eks_addon" "core" {
  for_each = toset(["vpc-cni", "kube-proxy", "coredns", "eks-pod-identity-agent"])

  cluster_name                = aws_eks_cluster.cluster.name
  addon_name                  = each.value
  resolve_conflicts_on_create = "OVERWRITE"
  resolve_conflicts_on_update = "OVERWRITE"

  depends_on = [aws_eks_node_group.default]
}

# 15. Output values, read after apply
output "vpc_id" {
  value = aws_vpc.client_vpc.id
}

output "public_subnet_ids" {
  value = aws_subnet.public_subnet[*].id
}

output "private_subnet_ids" {
  value = aws_subnet.private_subnet[*].id
}

output "security_group_id" {
  value = aws_security_group.web_sg.id
}

output "cluster_name" {
  value = aws_eks_cluster.cluster.name
}

output "cluster_endpoint" {
  value = aws_eks_cluster.cluster.endpoint
}

output "cluster_version" {
  value = aws_eks_cluster.cluster.version
}

output "kubeconfig_command" {
  value = "aws eks update-kubeconfig --region ${var.aws_region} --name ${aws_eks_cluster.cluster.name}"
}
EOF
