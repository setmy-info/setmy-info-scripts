#!/bin/sh

# Copyright (C) 2026 Imre Tabur <imre.tabur@mail.ee>

set -eu

forwardTo() {
    nft "flush chain inet global_firewall web_proxy; add rule inet global_firewall web_proxy jump $1"
}

case "${1:-}" in
    nginx)   forwardTo to_nginx ;;
    haproxy) forwardTo to_haproxy ;;
    *)       echo "Usage: $(basename "$0") nginx|haproxy" >&2; exit 1 ;;
esac
