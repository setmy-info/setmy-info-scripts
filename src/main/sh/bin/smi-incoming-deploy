#!/bin/sh

set -u

INCOMING_DIR="/var/opt/setmy.info/incoming"
DRAFT_INCOMING_DIR="${INCOMING_DIR}/draft"
FAILED_DIR="/var/opt/setmy.info/failed"

RESULT=0

# Deployment packages are RPMs and the external system drops one into the directory of the stage
# it wants:
#
#   /var/opt/setmy.info/incoming/*.rpm        published, publicly visible after deployment
#   /var/opt/setmy.info/incoming/draft/*.rpm  draft, visible to whoever may see the draft
#
# The stage is given to the scriptlets of the package in SMI_STAGE, "published" or "draft". rpm
# runs its scriptlets as child shells and passes its own environment on, so %pre and %post of the
# package read SMI_STAGE and put the content where that stage belongs. One package therefore
# serves both stages: the same file is uploaded to the draft directory, checked there, and then
# moved to the published directory by the external system, so the bytes that are published are
# the bytes that were approved. Nothing is built twice.
#
# rpm -U --replacepkgs --oldpackage, so an upgrade, a reinstall of the version that is already
# installed, which publishing a checked draft is, and a downgrade all work with one command.
#
# The package file belongs to this command: it is removed when the installation succeeded and
# moved to the failed directory of its stage when it did not. Nothing is ever left in an incoming
# directory, because setmy-info-deploy.path triggers on the incoming globs and a package left
# behind would start this service again and again.
moveToFailed() {
    PACKAGE=${1}
    STAGE_FAILED_DIR=${2}
    REASON=${3}
    mkdir -p "${STAGE_FAILED_DIR}"
    if mv -f "${PACKAGE}" "${STAGE_FAILED_DIR}/$(date -u +%Y%m%d-%H%M%SZ)-${PACKAGE##*/}"; then
        echo "smi-incoming-deploy: ${REASON}, moved to ${STAGE_FAILED_DIR}: ${PACKAGE##*/}" >&2
    else
        echo "smi-incoming-deploy: ${REASON} and could not be moved out of the incoming directory: ${PACKAGE}" >&2
    fi
}

deployStage() {
    STAGE=${1}
    STAGE_INCOMING_DIR=${2}
    STAGE_FAILED_DIR=${3}

    [ -d "${STAGE_INCOMING_DIR}" ] || return 0

    # On a Debian based machine the packages are .deb and the installer is dpkg, which passes
    # its environment to the maintainer scripts the same way rpm does, so SMI_STAGE reaches
    # preinst and postinst unchanged. Uncomment the two lines here and the two .deb globs of
    # setmy-info-deploy.path, and comment the .rpm ones, and nothing else has to change.
    #for PACKAGE in "${STAGE_INCOMING_DIR}"/*.deb; do
    for PACKAGE in "${STAGE_INCOMING_DIR}"/*.rpm; do
        [ -e "${PACKAGE}" ] || continue

        PACKAGE_NAME=${PACKAGE##*/}

        #if SMI_STAGE="${STAGE}" dpkg --install --force-confnew "${PACKAGE}"; then
        if SMI_STAGE="${STAGE}" rpm -U --replacepkgs --oldpackage "${PACKAGE}"; then
            echo "smi-incoming-deploy: installed ${STAGE} package ${PACKAGE_NAME}" >&2
            if rm -f "${PACKAGE}"; then
                echo "smi-incoming-deploy: removed ${PACKAGE_NAME}" >&2
            else
                echo "smi-incoming-deploy: installed ${PACKAGE_NAME}, but it could not be removed: ${PACKAGE}" >&2
                RESULT=1
            fi
        else
            moveToFailed "${PACKAGE}" "${STAGE_FAILED_DIR}" "${STAGE} package ${PACKAGE_NAME} could not be installed"
            RESULT=1
        fi
    done
}

deployStage draft "${DRAFT_INCOMING_DIR}" "${FAILED_DIR}/draft"
deployStage published "${INCOMING_DIR}" "${FAILED_DIR}"

exit ${RESULT}
