#!/bin/sh

# Copyright (C) 2024 Imre Tabur <imre.tabur@mail.ee>
# Create or update a single key in a Kubernetes ConfigMap.
# Usage: smi-k8s-configmap-set <NAMESPACE> <CONFIGMAP_NAME> <KEY> <VALUE>
#
# The ConfigMap is created if it does not exist, or the key is patched if it does.

NAMESPACE=${1}
CONFIGMAP_NAME=${2}
KEY=${3}
VALUE=${4}

if [ -z "${NAMESPACE}" ] || [ -z "${CONFIGMAP_NAME}" ] || [ -z "${KEY}" ] || [ -z "${VALUE}" ]; then
    echo "Usage: $0 <NAMESPACE> <CONFIGMAP_NAME> <KEY> <VALUE>" >&2
    exit 1
fi

kubectl create configmap "${CONFIGMAP_NAME}" \
    --namespace "${NAMESPACE}" \
    --from-literal="${KEY}=${VALUE}" \
    --dry-run=client -o yaml | kubectl apply -f -

exit ${?}
