#!/bin/sh

# POSIX-compatible script to create and push a Git version tag
# and update a 'latest' lightweight tag to point to it.

# Exit immediately if a command fails or if an unset variable is used
set -eu

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 <version>"
  exit 1
fi

VERSION="$1"

# Take the tags of the remote as they are first. A build machine keeps the tags of every earlier
# build, and a tag that was moved or recreated in the meantime then differs from the remote one,
# which the remote refuses. --force overwrites such a local tag, --prune-tags drops the ones that
# are gone from the remote, so what is local afterwards is what the remote has.
echo "🔄 Syncing tags with the remote..."
git fetch --force --prune --prune-tags --tags origin

if git rev-parse -q --verify "refs/tags/$VERSION" >/dev/null 2>&1; then
  echo "❌ Tag $VERSION already exists!"
  exit 1
fi

echo "🏷️  Creating tag $VERSION..."
git tag -a "$VERSION" -m "$VERSION"

echo "🔄 Updating tag 'latest' -> $VERSION"
git tag -f latest "$VERSION"

# Only the two tags this script made are pushed. "git push --tags" pushes every local tag, so one
# stale tag of an earlier build fails the whole push, and with it the build, after the new tag has
# already arrived.
echo "🚀 Pushing tag $VERSION and latest..."
git push origin "refs/tags/$VERSION"
git push -f origin "refs/tags/latest"

echo "✅ Done: $VERSION tagged and pushed."

exit 0
