#!/bin/sh

# smi-password-gen
# Usage:
#   smi-password-gen [LENGTH]
# Default length: 21

if [ $# -gt 1 ]; then
    echo "ERROR: too many arguments." >&2
    exit 1
fi

LENGTH="${1:-21}"

case "$LENGTH" in
    *[!0-9]*|0)
        echo "ERROR: LENGTH must be a positive integer." >&2
        exit 1
        ;;
esac

CHARSET='ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_!$%&*+=?#@~^.,:;[](){}<>'
CHARSET_LEN=$(printf '%s' "$CHARSET" | wc -c | tr -d ' ')

# Rejection-sampling threshold: discard bytes >= LIMIT to eliminate modulo bias
LIMIT=$(( (256 / CHARSET_LEN) * CHARSET_LEN ))

PASSWORD=""
DONE=0

while [ "$DONE" -lt "$LENGTH" ]
do
    BYTES=$(dd if=/dev/urandom bs=64 count=1 2>/dev/null | od -An -t u1)
    for BYTE in $BYTES
    do
        [ "$BYTE" -ge "$LIMIT" ] && continue
        INDEX=$(( BYTE % CHARSET_LEN + 1 ))
        CHAR=$(printf '%s' "$CHARSET" | cut -c "$INDEX")
        PASSWORD="${PASSWORD}${CHAR}"
        DONE=$(( DONE + 1 ))
        [ "$DONE" -ge "$LENGTH" ] && break
    done
done

printf '%s\n' "$PASSWORD"
