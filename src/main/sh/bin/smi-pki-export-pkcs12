#!/bin/sh

# Copyright (C) 2026 Imre Tabur <imre.tabur@mail.ee>

. $(smi-include pki.sh)

if [ "$#" -lt 4 ]; then
    echo "Usage: $(basename "$0") PRIV_KEY_FILE CERT_FILE P12_FILE FRIENDLY_NAME [CA_CERT_FILE]" >&2
    echo "Export password from SMI_PKI_PKCS12_PASSWORD, asked on the terminal when unset" >&2
    exit 1
fi

pkiExportPkcs12 "$@"

exit ${?}
