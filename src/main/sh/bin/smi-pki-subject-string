#!/bin/sh

. $(smi-include pki.sh)

if [ "$#" -lt 2 ]; then
    echo "Usage: $(basename "$0") DIRECTORY COMMON_NAME" >&2
    exit 1
fi

DIRECTORY="${1}"
COMMON_NAME="${2}"

if [ -f "${DIRECTORY}/${SUBJECT_FILE}" ]; then
    . "${DIRECTORY}/${SUBJECT_FILE}"
fi

pkiSubjectString "${COMMON_NAME}"
echo

exit ${?}
