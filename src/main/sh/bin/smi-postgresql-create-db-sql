#!/bin/sh

# Copyright (C) 2026 Imre Tabur <imre.tabur@mail.ee>

set -eu

if [ "$#" -ne 2 ]; then
    echo "Usage: $0 <database_name> <live|test>" >&2
    exit 1
fi

DB_NAME=$1
ENVIRONMENT=$2

case "$DB_NAME" in
    ''|[0-9]*|*[!a-z0-9_]*)
        echo "ERROR: Invalid database name: $DB_NAME" >&2
        exit 1
        ;;
esac

case "$ENVIRONMENT" in
    live|test)
        ;;
    *)
        echo "ERROR: Environment must be 'live' or 'test'." >&2
        exit 1
        ;;
esac

APP_USER="${ENVIRONMENT}${DB_NAME}"
LIQUIBASE_USER="${APP_USER}liquibase"
DB_NAME="${DB_NAME}_${ENVIRONMENT}"

APP_PASSWORD=$(smi-password-gen 24)
LIQUIBASE_PASSWORD=$(smi-password-gen 24)

cat <<EOF
CREATE USER $APP_USER;
CREATE USER $LIQUIBASE_USER;
ALTER USER $APP_USER WITH PASSWORD '$APP_PASSWORD';
ALTER USER $LIQUIBASE_USER WITH PASSWORD '$LIQUIBASE_PASSWORD';
CREATE DATABASE $DB_NAME WITH TEMPLATE = template0 ENCODING = 'UTF8';
ALTER DATABASE $DB_NAME OWNER TO $LIQUIBASE_USER;
REVOKE ALL ON DATABASE $DB_NAME FROM PUBLIC;
GRANT CONNECT, TEMPORARY ON DATABASE $DB_NAME TO $LIQUIBASE_USER;
GRANT CONNECT ON DATABASE $DB_NAME TO $APP_USER;
\connect $DB_NAME
ALTER SCHEMA public OWNER TO $LIQUIBASE_USER;
REVOKE ALL ON SCHEMA public FROM PUBLIC;
GRANT USAGE, CREATE ON SCHEMA public TO $LIQUIBASE_USER;
GRANT USAGE ON SCHEMA public TO $APP_USER;
GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO $APP_USER;
GRANT USAGE ON ALL SEQUENCES IN SCHEMA public TO $APP_USER;
ALTER DEFAULT PRIVILEGES FOR USER $LIQUIBASE_USER IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE ON TABLES TO $APP_USER;
ALTER DEFAULT PRIVILEGES FOR USER $LIQUIBASE_USER IN SCHEMA public GRANT USAGE ON SEQUENCES TO $APP_USER;
ALTER DEFAULT PRIVILEGES FOR USER $LIQUIBASE_USER REVOKE EXECUTE ON FUNCTIONS FROM PUBLIC;
ALTER DEFAULT PRIVILEGES FOR USER $LIQUIBASE_USER IN SCHEMA public GRANT EXECUTE ON FUNCTIONS TO $APP_USER;
EOF
