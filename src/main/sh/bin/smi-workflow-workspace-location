#!/bin/sh

# Copyright (C) 2024 Imre Tabur <imre.tabur@mail.ee>
# Returns the per-workflow working directory under operations/workflows/<uuid>.
# Falls back to $SMI_WORKSPACE when the full org PVC is not mounted (UUID-only subPath pattern).
#
# Usage: smi-workflow-workspace-location [COUNTRY_CODE [ORG_SHORT_NAME [UUID]]]

CC=${1:-${SMI_CC}}
ORG=${2:-${SMI_ORG}}
UUID=${3:-${SMI_WF_UUID}}

if [ -n "${SMI_WORKSPACE}" ] && [ $# -eq 0 ]; then
    echo "${SMI_WORKSPACE}"
    exit 0
fi

echo "$(smi-organization-location ${CC} ${ORG})/operations/workflows/${UUID}"

exit 0
