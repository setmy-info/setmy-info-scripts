doVersionChange() {
    NEW_VERSION="$1"
    MAJOR=$(printf '%s' "${NEW_VERSION}" | cut -d. -f1)
    MINOR=$(printf '%s' "${NEW_VERSION}" | cut -d. -f2)
    PATCH=$(printf '%s' "${NEW_VERSION}" | cut -d. -f3 | sed -e 's/[-+].*//')

    projectEditFile CMakeLists.txt sed \
        -e "s/\(SET (PROJECT_VERSION_MAJOR *\)[0-9]*/\1${MAJOR}/" \
        -e "s/\(SET (PROJECT_VERSION_MINOR *\)[0-9]*/\1${MINOR}/" \
        -e "s/\(SET (PROJECT_VERSION_PATCH *\)[0-9]*/\1${PATCH}/"

    projectEditFile README.md sed -e "s/SCRIPTS_VERSION=[0-9][0-9.]*/SCRIPTS_VERSION=${NEW_VERSION}/g"

    projectEditFile Doxyfile sed -e "s/^\(PROJECT_NUMBER *=\) *[0-9][0-9.]*/\1 ${NEW_VERSION}/"

    projectEditFile Dockerfile sed -e "s/setmy-info-scripts-[0-9][0-9.]*\.noarch/setmy-info-scripts-${NEW_VERSION}.noarch/g"

    projectEditFile src/main/sh/build/packages-build.sh sed -e "s/export PROJECT_VERSION=\"[0-9][0-9.]*\"/export PROJECT_VERSION=\"${NEW_VERSION}\"/"

    projectEditFile src/main/sh/build/check-files.sh sed -e "/smi-version/s/ \"[0-9][0-9.]*\"/ \"${NEW_VERSION}\"/"

    projectEditFile setup.iss sed -e "s/AppVersion=[0-9][0-9.]*/AppVersion=${NEW_VERSION}/"
}
