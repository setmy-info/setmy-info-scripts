#!/bin/sh

# Copyright (C) 2023 - etc Imre Tabur <imre.tabur@mail.ee>

if [ $# -lt 2 ]; then
    echo "Usage: $(basename ${0}) DISKLESS_NAME SERVER_IP"
    exit 1
fi

DISKLESS_NAME=${1}
SERVER_IP=${2}

. $(smi-include diskless.sh)

do_diskless_install ${DISKLESS_NAME} ${SERVER_IP} || exit 1

exit 0
