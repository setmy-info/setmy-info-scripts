[Unit]
Description=@PROVIDER@ example service
After=syslog.service network.target postgresql-15.service

[Service]
Type=simple
User=microservice
Group=microservice
EnvironmentFile=@SCRIPTS_INSTALL_PREFIX@/etc/environment.conf
ExecStart=@SCRIPTS_INSTALL_PREFIX@/bin/microservice start
ExecStop=@SCRIPTS_INSTALL_PREFIX@/bin/microservice stop
ExecReload=@SCRIPTS_INSTALL_PREFIX@/bin/microservice reload

[Install]
WantedBy=multi-user.target
