JDK27_NAME=jdk27
JDK27_VERSION=27.0.1
JDK27_HASH_PART=cb858dd9ef0246e1847750bdb65252fe
JDK27_NUMERIC_PART=9
JDK27_DIR_NAME=jdk-${JDK27_VERSION}
JDK27_NAME_PREFIX=openjdk-${JDK27_VERSION}
JDK27_TAR_FILE_NAME=${JDK27_NAME_PREFIX}_linux-x64_bin.tar
JDK27_TAR_GZ_FILE_NAME=${JDK27_TAR_FILE_NAME}.gz
JDK27_TAR_GZ_FILE_URL=https://download.java.net/java/GA/jdk${JDK27_VERSION}/${JDK27_HASH_PART}/${JDK27_NUMERIC_PART}/GPL/${JDK27_TAR_GZ_FILE_NAME}

# https://download.java.net/java/GA/jdk27.0.1/cb858dd9ef0246e1847750bdb65252fe/9/GPL/openjdk-27.0.1_linux-x64_bin.tar.gz

jdk27_download_func() {
    smi-download ${JDK27_TAR_GZ_FILE_URL} ${HOME_PACKAGES_DIR}/${JDK27_TAR_GZ_FILE_NAME}
}

jdk27_install_func() {
    sudo tar --overwrite -xvzf ${HOME_PACKAGES_DIR}/${JDK27_TAR_GZ_FILE_NAME} -C /opt
    makeOptLink /opt/jdk27 /opt/${JDK27_DIR_NAME}
}
