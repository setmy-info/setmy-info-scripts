LFE_NAME=lfe
LFE_VERSION=2.2.0
LFE_DIR_NAME=${LFE_NAME}-${LFE_VERSION}
LFE_TAR_FILE_NAME=${LFE_DIR_NAME}.tar
LFE_TAR_GZ_FILE_NAME=${LFE_TAR_FILE_NAME}.gz
LFE_TAR_GZ_FILE_URL=https://github.com/lfe/lfe/archive/refs/tags/v${LFE_VERSION}.tar.gz

# https://github.com/lfe/lfe/archive/refs/tags/v2.2.0.tar.gz

lfe_download_func() {
    smi-download ${LFE_TAR_GZ_FILE_URL} ${HOME_PACKAGES_DIR}/${LFE_TAR_GZ_FILE_NAME}
}

lfe_install_func() {
    sudo tar --overwrite -xvzf ${HOME_PACKAGES_DIR}/${LFE_TAR_GZ_FILE_NAME} -C /opt
    makeOptLink /opt/${LFE_NAME} /opt/${LFE_DIR_NAME}
}
