MISE_NAME=mise
MISE_VERSION=2026.11.14
MISE_DIR_NAME=${MISE_NAME}-${MISE_VERSION}
MISE_TAR_GZ_FILE_NAME=${MISE_NAME}-v${MISE_VERSION}-linux-x64.tar.gz
MISE_TAR_GZ_FILE_URL=https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/${MISE_TAR_GZ_FILE_NAME}

mise_download_func() {
    smi-download ${MISE_TAR_GZ_FILE_URL} ${HOME_PACKAGES_DIR}/${MISE_TAR_GZ_FILE_NAME}
}

mise_install_func() {
    sudo mkdir -p /opt/${MISE_DIR_NAME}
    sudo tar --overwrite -xvzf ${HOME_PACKAGES_DIR}/${MISE_TAR_GZ_FILE_NAME} -C /opt/${MISE_DIR_NAME} --strip-components=1
    makeOptLink /opt/${MISE_NAME} /opt/${MISE_DIR_NAME}
}
