MAVEN4_NAME=maven
MAVEN4_VERSION=4.0.0
MAVEN4_BETA_VERSION=rc-7
MAVEN4_DIR_NAME=apache-maven-${MAVEN4_VERSION}-${MAVEN4_BETA_VERSION}
MAVEN4_TAR_FILE_NAME=${MAVEN4_DIR_NAME}-bin.tar
MAVEN4_TAR_GZ_FILE_NAME=${MAVEN4_TAR_FILE_NAME}.gz
MAVEN4_TAR_GZ_FILE_URL=https://dlcdn.apache.org/maven/maven-4/${MAVEN4_VERSION}-${MAVEN4_BETA_VERSION}/binaries/${MAVEN4_TAR_GZ_FILE_NAME}

# https://dlcdn.apache.org/maven/maven-4/4.0.0-rc-7/binaries/apache-maven-4.0.0-rc-7-bin.tar.gz
# The release candidate part belongs in the directory name as well, as that is what the archive
# unpacks into; the mirror keeps only the newest candidates, so an old one is a 404.

mvn4_download_func() {
    smi-download ${MAVEN4_TAR_GZ_FILE_URL} ${HOME_PACKAGES_DIR}/${MAVEN4_TAR_GZ_FILE_NAME}
}

mvn4_install_func() {
    sudo tar --overwrite -xvzf ${HOME_PACKAGES_DIR}/${MAVEN4_TAR_GZ_FILE_NAME} -C /opt
    makeOptLink /opt/maven4 /opt/${MAVEN4_DIR_NAME}
}
