TELEGRAM_NAME=telegram
TELEGRAM_VERSION=7.3.3
TELEGRAM_DIR_NAME=${TELEGRAM_NAME}-${TELEGRAM_VERSION}
TELEGRAM_TAR_XZ_FILE_NAME=td-setup-linux-x64-${TELEGRAM_VERSION}.tar.xz
TELEGRAM_TAR_XZ_FILE_URL=https://github.com/telegramdesktop/tdesktop/releases/download/v${TELEGRAM_VERSION}/${TELEGRAM_TAR_XZ_FILE_NAME}

# https://github.com/telegramdesktop/tdesktop/releases
# The asset was tsetup.<version>.tar.xz until the project renamed its release assets; the
# archive itself is unchanged, one Telegram directory, which --strip-components=1 removes.

telegram_download_func() {
    smi-download ${TELEGRAM_TAR_XZ_FILE_URL} ${HOME_PACKAGES_DIR}/${TELEGRAM_TAR_XZ_FILE_NAME}
}

telegram_install_func() {
    sudo rm -rf /opt/${TELEGRAM_DIR_NAME}
    sudo mkdir -p /opt/${TELEGRAM_DIR_NAME}
    sudo tar --overwrite --strip-components=1 -xvJf ${HOME_PACKAGES_DIR}/${TELEGRAM_TAR_XZ_FILE_NAME} -C /opt/${TELEGRAM_DIR_NAME}
    makeOptLink /opt/${TELEGRAM_NAME} /opt/${TELEGRAM_DIR_NAME}
}
