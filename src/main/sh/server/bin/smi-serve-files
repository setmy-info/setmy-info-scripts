#!/bin/sh

# Copyright (C) 2026 Imre Tabur <imre.tabur@mail.ee>

set -eu

. $(smi-include elixir.sh)

SERVE_USER=microservice
DEFAULT_PORT=8140

ERLANG_DIR=/opt/erlang
ELIXIR_DIR=/opt/elixir
ERLANG_BIN_DIR=${ERLANG_DIR}/bin
ELIXIR_BIN_DIR=${ELIXIR_DIR}/bin
PATH=${ERLANG_BIN_DIR}:${ELIXIR_BIN_DIR}:${PATH}

CONFIG_FILE=${1:-$(smi-etc-location)/smi-serve-files.config}
PORT=${2:-${DEFAULT_PORT}}

case "${PORT}" in
    *[!0-9]*|'')
        echo "ERROR: invalid port: ${PORT}" >&2
        exit 1
        ;;
esac
if [ "${PORT}" -lt 1 ] || [ "${PORT}" -gt 65535 ]; then
    echo "ERROR: invalid port: ${PORT}" >&2
    exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: must be run as root" >&2
    exit 1
fi

if ! id "${SERVE_USER}" >/dev/null 2>&1; then
    echo "ERROR: user does not exist: ${SERVE_USER}" >&2
    exit 1
fi

if [ ! -f "${CONFIG_FILE}" ]; then
    echo "ERROR: config file not found: ${CONFIG_FILE}" >&2
    exit 1
fi

secureWebRoot() {
    WWW_DIR=${1}
    case "${WWW_DIR}" in
        /*) ;;
        *)
            echo "ERROR: directory must be absolute: ${WWW_DIR}" >&2
            exit 1
            ;;
    esac
    if [ "${WWW_DIR}" = "/" ]; then
        echo "ERROR: refusing to serve /" >&2
        exit 1
    fi
    if [ ! -d "${WWW_DIR}" ]; then
        echo "ERROR: web root not found: ${WWW_DIR}" >&2
        exit 1
    fi
    if find "${WWW_DIR}" ! -type f ! -type d | grep -q .; then
        echo "ERROR: only regular files and directories are allowed in ${WWW_DIR}" >&2
        exit 1
    fi
    chown -R root:root "${WWW_DIR}"
    find "${WWW_DIR}" -type d -exec chmod 755 {} +
    find "${WWW_DIR}" -type f -exec chmod 644 {} +
}

MAPPINGS=0
while read -r HOST DIR _; do
    case "${HOST}" in
        ''|'#'*)
            continue
            ;;
    esac
    case "${HOST}" in
        *[!A-Za-z0-9.-]*|-*)
            echo "ERROR: invalid host name: ${HOST}" >&2
            exit 1
            ;;
    esac
    if [ -z "${DIR}" ]; then
        echo "ERROR: host without directory: ${HOST}" >&2
        exit 1
    fi
    secureWebRoot "${DIR}"
    MAPPINGS=$((MAPPINGS + 1))
done < "${CONFIG_FILE}"

if [ "${MAPPINGS}" -eq 0 ]; then
    echo "ERROR: no host mappings in ${CONFIG_FILE}" >&2
    exit 1
fi

WORK_DIR=$(smi-var-location)/smi-serve-files/workingdir
mkdir -p "${WORK_DIR}"
chown -R "${SERVE_USER}:${SERVE_USER}" "${WORK_DIR}"
chmod 700 "${WORK_DIR}"

cd "${WORK_DIR}" || exit 1

exec sudo -u "${SERVE_USER}" \
    env PATH="${PATH}" \
        HOME="${WORK_DIR}" \
        LANG="${LANG:-en_US.UTF-8}" \
        ELIXIR_ERL_OPTIONS="+fnu" \
        MIX_INSTALL_DIR="${WORK_DIR}/mix-install" \
        elixir "${SMI_ELIXIR_LIB_DIR}/smi-serve-files.exs" "${CONFIG_FILE}" "${PORT}"
