#!/bin/sh

# Copyright (C) 2026 Imre Tabur <imre.tabur@mail.ee>

set -eu

TARGET_DIR=${1:-}

if [ -z "${TARGET_DIR}" ]; then
    echo "Usage: $(basename ${0}) <target-directory>" >&2
    exit 1
fi

if [ ! -d "${TARGET_DIR}" ]; then
    echo "ERROR: target directory not found: ${TARGET_DIR}" >&2
    exit 1
fi

BACKUP_DIR=${TARGET_DIR}/$(smi-timestamp)
mkdir -p "${BACKUP_DIR}"

backupDirectory() {
    SOURCE_DIR=${1}
    shift
    if [ ! -d "${SOURCE_DIR}" ]; then
        return 0
    fi
    ARCHIVE_NAME=$(basename "${SOURCE_DIR}" | sed 's/^\.//')
    tar "$@" -czf "${BACKUP_DIR}/${ARCHIVE_NAME}.tar.gz" -C "$(dirname "${SOURCE_DIR}")" "$(basename "${SOURCE_DIR}")"
    echo "${BACKUP_DIR}/${ARCHIVE_NAME}.tar.gz"
}

for GNUPG_DIR in "${HOME}"/.gnupg*; do
    backupDirectory "${GNUPG_DIR}"
done
backupDirectory "${HOME}/.ssh"
backupDirectory "${HOME}/.pki"
backupDirectory "${HOME}/.dev-certs"
backupDirectory "${HOME}/.revelation"
backupDirectory "${HOME}/.mozilla"
backupDirectory "${HOME}/.thunderbird"
backupDirectory "${HOME}/Backup"
backupDirectory "${HOME}/Documents"
backupDirectory "${HOME}/Pictures"
backupDirectory "${HOME}/Music"
backupDirectory "${HOME}/Videos"
backupDirectory "${HOME}/sources" --exclude=target --exclude=node_modules --exclude=.venv

exit 0
